# ============================================================================
#  proxy — configuración. Copia este archivo a .env y edita.
#  Todo lo que aparece acá se puede pasar también como variable de entorno.
# ============================================================================

# --- API de Bitunix (futuros USDT-M) ----------------------------------------
# Crea la API key en Bitunix: sin permiso de retiro, con permiso de trade, y
# (recomendado) restringida por IP al VPS.
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
MARGIN_COIN=USDT

# --- Servidor webhook -------------------------------------------------------
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
WEBHOOK_PATH=/webhook
# Secreto del webhook: va en la header X-Webhook-Token, en ?token=... o en la
# ruta /webhook/<token>. Vacío = sin autenticación (NO recomendado).
WEBHOOK_TOKEN=cambia-esto-por-un-string-largo-y-aleatorio
# Frase opcional que debe aparecer dentro del mensaje de la alerta.
WEBHOOK_KEYWORD=
MAX_BODY_KB=64

# --- Tamaño de la posición --------------------------------------------------
# % de la cuenta que usa el bot por operación.
POSITION_SIZE_PCT=10
# margin  -> el % es MARGEN (exposición = % * apalancamiento)  <- comportamiento pedido
# notional-> el % es NOCIONAL (el margen sale de dividir por el apalancamiento)
SIZING_MODE=margin
# Tope de MARGEN sumado entre todas las operaciones activas, sobre el equity.
# Con 10% por trade y x20, deja de aceptar señales cuando 5 trades llenan el 50%.
# 0 = sin tope (no recomendado: a x20 un trade = 2x el equity en exposición).
MAX_TOTAL_MARGIN_PCT=0

# --- Apalancamiento ---------------------------------------------------------
DEFAULT_LEVERAGE=20
USE_SIGNAL_LEVERAGE=true
# Tope de seguridad: aunque la señal pida x75, nunca se usa más de esto.
MAX_LEVERAGE=20

# --- Margen ---------------------------------------------------------------
# Fijo en ISOLATION (aislado). El script lo fuerza en cada símbolo antes de operar.
MARGIN_MODE=ISOLATION

# --- Límites de riesgo -----------------------------------------------------
# Operaciones gestionadas a la vez. 0 = sin límite.
MAX_OPEN_POSITIONS=0
# true = permite abrir en contra de una posición abierta (y repetir símbolo no).
ALLOW_REVERSE=false
# Rechaza la señal si el precio de entrada está a más de este % del precio de mercado
# (protege contra señales viejas o mal escritas). 0 = desactivado.
MAX_PRICE_DEVIATION_PCT=0

# --- Orden de entrada ------------------------------------------------------
ENTRY_ORDER_TYPE=LIMIT
ENTRY_TIME_IN_FORCE=GTC
# Cancela la orden límite si no se llenó en N segundos (0 = dejarla viva).
LIMIT_ORDER_TTL_SEC=900

# --- Take profit / stop loss ----------------------------------------------
# partials = SL en la posición + una orden TP por cada objetivo (repartiendo tamaño)
# single   = una única orden TP/SL de posición sobre un solo objetivo
TP_MODE=partials
SINGLE_TP_TARGET=first
# equal = partes iguales | "20,20,20,20,20" = porcentaje por objetivo
TP_SPLIT=equal
TP_STOP_TYPE=LAST_PRICE
SL_STOP_TYPE=LAST_PRICE
TP_ORDER_TYPE=MARKET
SL_ORDER_TYPE=MARKET

# --- Break-even ------------------------------------------------------------
BE_ENABLED=true
# fill = cuando se ejecuta el objetivo | price = cuando el precio lo cruza | both
BE_TRIGGER=both
BE_AFTER_TP=1
# Offset sobre el precio de entrada para cubrir fees (0.1 = 0.1%).
BE_OFFSET_PCT=0.1
BE_CANCEL_REMAINING_TP=false

# --- Operativa -------------------------------------------------------------
POLL_INTERVAL_SEC=5
# Segundos que espera el webhook a que llene la entrada para armar SL/TP en el acto (0 = sólo monitor).
FAST_ARM_SEC=12
DEDUPE_WINDOW_SEC=0   # señal idéntica dentro de la ventana se ignora; 0 = siempre ejecuta
REQUEST_TIMEOUT_SEC=15
RETRIES=3
STATE_FILE=proxy_state.json
LOG_FILE=proxy.log
LOG_LEVEL=INFO
# Cuántos eventos se guardan en memoria para GET /events.
EVENT_BUFFER=400

# Pruebas: true = no envía nada al exchange, sólo loguea lo que haría.
DRY_RUN=false
DRY_RUN_EQUITY=1000
# En dry-run el monitor simula el ciclo completo (fill -> TP1 -> break-even -> cierres)
# para poder probar señales y avisos sin dinero real.
DRY_RUN_SIM=true
# Segundos que dura cada fase de esa simulación.
DRY_RUN_PHASE_SEC=18

[Unit]
Description=proxy: webhook de señales -> Bitunix futures
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajusta la ruta y el usuario a tu VPS.
User=trader
Group=trader
WorkingDirectory=/opt/proxy
ExecStart=/opt/proxy/proxy serve
# El .env vive junto al script; systemd no lo lee solo, pero proxy.py sí lo carga.
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TZ=UTC

# Recursos / seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
